rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------------
    // STARTER RULES — good enough for development / a single trusted owner
    // account. Tighten before letting multiple staff accounts write data.
    // ------------------------------------------------------------------

    match /{document=**} {
      // Only signed-in users (via Firebase Auth) can read/write anything.
      allow read, write: if request.auth != null;
    }

    // Example of a more granular setup once you add staff roles
    // (uncomment and remove the block above when ready):
    //
    // match /products/{productId} {
    //   allow read: if request.auth != null;
    //   allow write: if request.auth != null; // restrict to admin role later
    // }
    // match /stock/{stockId} {
    //   allow read: if request.auth != null;
    //   allow write: if request.auth != null;
    // }
    // match /bills/{billId} {
    //   allow read, create: if request.auth != null;
    //   allow update, delete: if false; // bills should be immutable once created
    //   match /billItems/{itemId} {
    //     allow read, create: if request.auth != null;
    //     allow update, delete: if false;
    //   }
    // }
  }
}
